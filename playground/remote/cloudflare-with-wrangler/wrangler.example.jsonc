{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "<YOUR_WORKER_NAME>",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "<YOUR_R2_BUCKET_NAME>"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ]
}
