{
  "name": "wvb-electron-builder-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "builtin": "wvb builtin",
    "dev": "wvb builtin && {{{buildMainCommand}}} && {{{buildPreloadCommand}}} && electron .",
    "build": "{{{buildMainCommand}}} && {{{buildPreloadCommand}}} && electron-builder --config electron-builder.config.js --publish never",
    "build:main": "esbuild src/main.ts --bundle --outdir=dist --platform=node --format=cjs --external:electron --external:@wvb/electron",
    "build:preload": "esbuild src/preload.ts --bundle --outdir=dist --platform=node --format=cjs --external:electron"
  },
  "devDependencies": {
    "@wvb/cli": "0.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "@wvb/electron-builder": "0.3.0",
    "esbuild": "0.28.2",
    "typescript": "~7.0.2"
  },
  "main": "./dist/main.js",
  "dependencies": {
    "@wvb/electron": "0.3.1"
  }
}
