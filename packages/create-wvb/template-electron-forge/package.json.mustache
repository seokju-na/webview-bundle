{
  "name": "wvb-electron-forge-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "builtin": "wvb builtin",
    "dev": "wvb builtin && {{{buildMainCommand}}} && {{{buildPreloadCommand}}} && electron-forge start",
    "build": "{{{buildMainCommand}}} && {{{buildPreloadCommand}}} && electron-forge package",
    "make": "{{{buildMainCommand}}} && {{{buildPreloadCommand}}} && electron-forge make",
    "typecheck": "tsc --noEmit",
    "build:main": "esbuild src/main.ts --bundle --outdir=dist --platform=node --format=cjs --external:electron --external:@wvb/electron",
    "build:preload": "esbuild src/preload.ts --bundle --outdir=dist --platform=node --format=cjs --external:electron"
  },
  "devDependencies": {
    "@wvb/cli": "0.3.0",
    "electron": "45.0.0",
    "@electron-forge/cli": "^7",
    "@electron-forge/maker-zip": "^7",
    "@wvb/electron-forge": "0.3.0",
    "@electron-forge/shared-types": "^7",
    "typescript": "~7.0.2",
    "@types/node": "^25",
    "esbuild": "0.28.2"
  },
  "main": "./dist/main.js",
  "dependencies": {
    "@wvb/electron": "0.3.1"
  },
  "config": {
    "forge": "./forge.config.ts"
  }
}
